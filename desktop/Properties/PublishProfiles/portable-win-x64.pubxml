<?xml version="1.0" encoding="utf-8"?>
<!-- Portable build: one self-contained AudioParty.exe, no .NET install needed on the user's PC.
     Run via desktop/build-release.ps1 (or: dotnet publish -p:PublishProfile=portable-win-x64). -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <PublishDir>$(MSBuildProjectDirectory)\dist\</PublishDir>
  </PropertyGroup>
</Project>
