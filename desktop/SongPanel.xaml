<UserControl x:Class="AudioPartyDesktop.SongPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="{DynamicResource Surface}" CornerRadius="12" Padding="16">
        <StackPanel HorizontalAlignment="Center">
            <TextBlock x:Name="StatusText" Foreground="{DynamicResource TextSecondary}"
                       FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"/>
            <TextBlock x:Name="TitleText" Foreground="{DynamicResource TextPrimary}" FontSize="16" FontWeight="Bold"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="ArtistText" Foreground="{DynamicResource Primary}" FontSize="13"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
            <TextBlock x:Name="AlbumText" Foreground="{DynamicResource TextSecondary}" FontSize="11"
                       HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" Visibility="Collapsed"/>
        </StackPanel>
    </Border>
</UserControl>
